[Unit]
Description=Telegram ingest agent (LLM categorization)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tg-ingest
Group=tg-ingest
UMask=0077
EnvironmentFile=/etc/tg-ingest-agent.env
ExecStart=/usr/bin/python3 /opt/tg-ingest-agent/agent.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# See the installer heredoc (the deployed source of truth): the agent pings
# WATCHDOG=1 from inside its long primitives (every model call, every
# transcription attempt, every drained job) so a wedged poll loop is restarted
# instead of reporting active/running forever, while a legitimately slow step is
# not. Type=simple + NotifyAccess=main on purpose. The budget must exceed the
# longest un-pinged span: a cold transcription (STT_LOCAL_TIMEOUT_SECONDS + ffmpeg).
NotifyAccess=main
WatchdogSec=900
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tg-ingest-agent
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
