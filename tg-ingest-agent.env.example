# tg-ingest-agent configuration (/etc/tg-ingest-agent.env, mode 0600).
# systemd EnvironmentFile syntax: no inline comments after values.

# New dedicated bot from @BotFather (NOT the fleet codex-auto-update bot).
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Comma-separated numeric chat ids allowed to feed the bot.
# To find yours: message the bot once and check journalctl for "ignored chat_id=".
ALLOWED_CHAT_IDS=REPLACE_ME

# DigitalOcean Gradient serverless inference access key (dedicated to this agent).
DO_MODEL_ACCESS_KEY=REPLACE_ME

# --- Conversation ------------------------------------------------------------
# Bot reply language: ru or en (changeable at runtime: "запомни: отвечай по-английски").
# BOT_LANGUAGE=ru
# Your local timezone as UTC offset hours (MSK = 3); used for reminder times.
# TIMEZONE_OFFSET_HOURS=3
# Router guesses below this confidence ask a clarifying question instead.
# ROUTER_CONFIDENCE_THRESHOLD=0.6
# Model for intent routing (defaults to DO_CHAT_MODEL).
# ROUTER_MODEL=anthropic-claude-haiku-4.5

# --- Voice ---------------------------------------------------------------
# STT_ENABLED=true
# STT_MODE=local  -> whisper.cpp on this host (free; install via
#                    install-whisper-pilot-remote.sh; ~1 min per 30 s note on 1 vCPU)
# STT_MODE=remote -> OpenAI-compatible /v1/audio/transcriptions endpoint
# STT_MODE=remote
# WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small-q5_1.bin
# STT_LOCAL_TIMEOUT_SECONDS=600
# STT_MODEL=whisper-large-v3

# --- Spend control -----------------------------------------------------------
# Hard budgets: at 80% the bot warns, at 100% LLM calls stop (messages are
# still stored and processed after the budget period resets).
# BUDGET_DAILY_USD=1.0
# BUDGET_MONTHLY_USD=15.0
# Price overrides, USD per 1M tokens [input, output]:
# PRICING_JSON={"anthropic-claude-haiku-4.5": [1.0, 5.0]}

# --- Calendar ------------------------------------------------------------
# "добавь в календарь..." always works: without Google setup the bot sends an
# .ics file. To sync straight into Google Calendar: create a GCP service
# account with Calendar API enabled, share your calendar with its
# client_email, drop the JSON key at GCAL_SA_KEY_FILE — `chown tg-ingest:` +
# chmod 0600 (the service reads it as the tg-ingest user; a root-owned 0600
# key fails every read) — and set:
# GCAL_CALENDAR_ID=you@gmail.com
# GCAL_SA_KEY_FILE=/etc/tg-ingest-agent/gcal-sa.json
# EVENT_DURATION_MINUTES=30
# Auto-sync each confirmed reminder: tell the bot "всегда добавляй
# напоминания в календарь" (preference auto_calendar).

# --- Learning ------------------------------------------------------------
# After this many same-category confirmations from one source, the bot offers
# to auto-confirm that source.
# HABIT_THRESHOLD=10

# --- Housekeeping ----------------------------------------------------------
# Interim artifacts (voice notes, orphaned media) are auto-purged after
# processing; review .md exports are trimmed to the newest N.
# REVIEW_KEEP=10

# --- Remote fetch ----------------------------------------------------------
# Reading a link the operator sends ("прочитай https://..."); SSRF-guarded
# (public http/https + public t.me only).
# FETCH_ENABLED=true
# FETCH_TIMEOUT_SECONDS=20
# FETCH_MAX_BYTES=2097152

# --- Binary storage --------------------------------------------------------
# Default 'local' (files under MEDIA_DIR). Set 'spaces' + the keys below to
# also upload photos to a DigitalOcean Space for durability. Built now,
# dormant until configured (with backend=local nothing changes).
# STORAGE_BACKEND=local
# SPACES_REGION=fra1
# SPACES_BUCKET=cara-media
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# SPACES_KEY=REPLACE_ME
# SPACES_SECRET=REPLACE_ME
# SPACES_PREFIX=media

# --- Taxonomy ------------------------------------------------------------
# Optional seed (comma/pipe-separated); categories also emerge from confirmed
# suggestions.
# CATEGORIES=news,tools,ideas
# CATEGORIES_FILE=/etc/tg-ingest-agent/categories.txt
# FALLBACK_CATEGORY=uncategorized

# --- Companion register & intimacy ----------------------------------------
# Her resting tone is set by whether it's work time AND whether he's been doing
# business recently — never a rigid day/night gate, and always overridden by how
# personal his actual message is. After heavy business she stays in working style
# for WORK_REGISTER_HOLD_MINUTES, then eases back to the time-of-day baseline.
# WORK_REGISTER_HOLD_MINUTES=40
# WORK_HOURS_START=9
# WORK_HOURS_END=19
# WORK_DAYS=0,1,2,3,4              # weekday numbers, 0=Mon .. 6=Sun (default Mon-Fri)
# Proactive intimacy outreach: off-hours, like a remote girlfriend keeping in touch
# (missing/craving/teasing by hint, never graphic), scaled by closeness. Conservative.
# INTIMACY_OUTREACH_ENABLED=true
# INTIMACY_OUTREACH_PROBABILITY=0.25
# INTIMACY_OUTREACH_MIN_STAGE=2          # closeness stage before she reaches out this way
# INTIMACY_OUTREACH_MAX_PER_DAY=1
# INTIMACY_OUTREACH_AFTER_CONTACT_HOURS=6  # only within a live exchange, not a long silence
# Don't interrupt an intimate / together moment with business pings: a due reminder (and
# proactive nudges) are held during a live social meeting or for this many minutes after an
# intimate message, then delivered once it passes. Overdue past the max-defer fires anyway.
# INTIMATE_QUIET_MINUTES=25
# REMINDER_MAX_DEFER_HOURS=2
# A fired one-shot reminder left unacked auto-closes after this many days (0 disables),
# so the "ждёт готово" list doesn't pile up. Reminders also hold during QUIET_HOURS and
# deliver when the window ends (never a 1 AM fire).
# REMINDER_FIRED_EXPIRE_DAYS=3

# --- Models / plumbing -----------------------------------------------------
# Vision-capable model id on DO Gradient serverless inference.
# Alternatives: anthropic-claude-4.6-sonnet, openai-gpt-4o
# DO_CHAT_MODEL=anthropic-claude-haiku-4.5
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# DB_PATH=/var/lib/tg-ingest-agent/ingest.db
# MEDIA_DIR=/var/lib/tg-ingest-agent/media
# POLL_TIMEOUT_SECONDS=50
# ALBUM_SETTLE_SECONDS=3
# MAX_LLM_IMAGES=4
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_ATTEMPTS=5
# RETRY_INTERVAL_SECONDS=300

# --- Fleet deploy notices --------------------------------------------------
# Build/deploy notices post to the shared FLEET notification bot (the ops channel the
# other VPSes use), NOT into the boss's chat with Cara. Copy the values from the box's
# root-only /etc/codex-auto-update/telegram.env (the tg-ingest user can't read that file,
# and its var names collide with Cara's own token, so they're re-declared here under
# distinct names). Leave blank to skip deploy notices entirely.
# FLEET_NOTIFY_BOT_TOKEN=123456:AA...        # the fleet bot token (NOT Cara's)
# FLEET_NOTIFY_CHAT_ID=160568780             # the fleet ops chat id
# FLEET_NOTIFY_LABEL=tg-ingest-agent (Cara)  # shown in the notice line
