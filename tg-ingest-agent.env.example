# tg-ingest-agent configuration (/etc/tg-ingest-agent.env, mode 0600).
# systemd EnvironmentFile syntax: no inline comments after values.

# New dedicated bot from @BotFather (NOT the fleet codex-auto-update bot).
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Comma-separated numeric chat ids allowed to feed the bot.
# To find yours: message the bot once and check journalctl for "ignored chat_id=".
ALLOWED_CHAT_IDS=REPLACE_ME

# DigitalOcean Gradient serverless inference access key (dedicated to this agent).
DO_MODEL_ACCESS_KEY=REPLACE_ME

# --- Conversation ------------------------------------------------------------
# Bot reply language: ru or en (changeable at runtime: "запомни: отвечай по-английски").
# BOT_LANGUAGE=ru
# Your local timezone as UTC offset hours (MSK = 3); used for reminder times.
# TIMEZONE_OFFSET_HOURS=3
# Cara's OWN timezone (her fictional life). Defaults to yours, so she only ever
# mentions "her time" when this is deliberately set to something different.
# CARA_TIMEZONE_OFFSET_HOURS=3
# A routed guess below this confidence falls back to warm conversation — it is a
# closed action set, so a low-confidence read is never an unrouted free-for-all.
# ROUTER_CONFIDENCE_THRESHOLD=0.6
# Model for intent routing (defaults to DO_CHAT_MODEL).
# ROUTER_MODEL=deepseek-4-flash
# Failed update payloads remain durable and retry before becoming dead letters.
# UPDATE_MAX_ATTEMPTS=3
# Personality intensity 0 (neutral) .. 3 (max). Selects template VARIANTS only —
# it never loosens a hard rule or changes what an action does.
# PERSONALITY_INTENSITY=2
# recall_conversation ("перечитай наш разговор вчера вечером"): how far back to read
# when he names no window, and the cap on how many turns are handed to the model.
# RECALL_DEFAULT_HOURS=60
# RECALL_MAX_TURNS=300

# --- Voice ---------------------------------------------------------------
# STT_ENABLED=true
# STT_MODE must be exactly one of local | local_server | remote — any other value
# is rejected at startup with a SystemExit (it used to fall through to `remote`,
# i.e. a typo shipped private voice audio off the box). Because that rejection
# stops the service, this one line is parsed forgivingly: a trailing `# comment`
# is stripped (systemd's EnvironmentFile does NOT strip inline comments, and a
# restart loop over a trailing note would be absurd). Other keys are not — keep
# comments on their own line everywhere.
# The three modes (only the LAST line below is a template line to uncomment — the
# explanations deliberately do not look like assignments any more, because
# uncommenting one would put the prose inside the value):
#   local        -> cold whisper.cpp CLI on this host (free; install via
#                   install-whisper-pilot-remote.sh; ~1 min per 30 s note on 1 vCPU)
#   local_server -> the warm on-box whisper-server (no per-call model reload;
#                   what the live box runs). Falls back to the CLI if the
#                   server is unreachable, and is health-monitored.
#   remote       -> OpenAI-compatible /v1/audio/transcriptions endpoint
#                   (audio LEAVES the box and is billed per audio minute)
# STT_MODE=remote
# WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small-q5_1.bin
# WHISPER_SERVER_URL=http://127.0.0.1:8089
# STT_LOCAL_TIMEOUT_SECONDS=600
#   ^ COUPLED TO THE UNIT: the systemd watchdog (WatchdogSec=900) must exceed the
#     longest un-pinged step, and a cold transcription is that step. Keep this
#     comfortably below WatchdogSec minus ~120 s of ffmpeg/teardown, i.e. <= 780.
#     Above that, systemd would SIGABRT her mid-voice-note; the agent logs a
#     startup WARNING naming both numbers if you cross the line.
# STT_MODEL=whisper-large-v3
# Language hint for Whisper. `auto` lets it detect, but a wrong guess in the first
# moments produces YouTube-style hallucinations ("[Subscribe]", "Спасибо за просмотр");
# pinning one language cuts those for a single-language speaker. The live box pins ru,
# which is why English voice notes on it transcribe worse than English text.
# STT_LANGUAGE=auto

# --- Spend control -----------------------------------------------------------
# Hard budgets: at 80% the bot warns, at 100% LLM calls stop (messages are
# still stored and processed after the budget period resets).
BUDGET_DAILY_USD=0.80
BUDGET_MONTHLY_USD=12.00
# Price overrides, USD per 1M tokens [input, output]:
# PRICING_JSON={"deepseek-4-flash": [0.0, 0.0]}
# A model slug that is in neither llm.DEFAULT_PRICING nor PRICING_JSON bills at the
# punitive $3/$15 default: the agent now logs a startup warning naming the slug and
# marks its rows in the spend report with "(default-priced!)".

# --- Calendar ------------------------------------------------------------
# "добавь в календарь..." always works: without Google setup the bot sends an
# .ics file. To sync straight into Google Calendar: create a GCP service
# account with Calendar API enabled, share your calendar with its
# client_email, drop the JSON key at GCAL_SA_KEY_FILE — `chown tg-ingest:` +
# chmod 0600 (the service reads it as the tg-ingest user; a root-owned 0600
# key fails every read) — and set:
# GCAL_CALENDAR_ID=you@gmail.com
# GCAL_SA_KEY_FILE=/etc/tg-ingest-agent/gcal-sa.json
# EVENT_DURATION_MINUTES=30
# Auto-sync each confirmed reminder: tell the bot "всегда добавляй
# напоминания в календарь" (preference auto_calendar).

# --- Learning ------------------------------------------------------------
# After this many same-category confirmations from one source, the bot offers
# to auto-confirm that source.
# HABIT_THRESHOLD=10

# --- Schedules & proactivity -------------------------------------------------
# Weekly performance review, in YOUR local time. Weekday 0=Mon .. 6=Sun.
# REVIEW_WEEKDAY=0
# REVIEW_HOUR=10
# Morning brief: OFF unless you ask for it ("делай мне утреннюю сводку"). When on it
# fires once a day at/after this local hour, obeying PROACTIVE_ENABLED and quiet hours.
# MORNING_BRIEF_HOUR=9
# Proactive heartbeat: gentle, suggestion-only nudges (overdue reminders, memory
# candidates waiting, a note-review invitation). She never ACTS on her own.
# PROACTIVE_ENABLED=true
# Quiet hours as local hours (start..end, wrapping past midnight): no nudges inside.
# QUIET_HOURS_START=22
# QUIET_HOURS_END=8
# At most this many NON-urgent nudges per day (an overdue reminder may bypass the cap).
# PROACTIVE_MAX_PER_DAY=1
# Whether an URGENT nudge may also break quiet hours. Off by default: a due reminder
# still fires on time regardless — this only governs the heartbeat's own nudges.
# PROACTIVE_URGENT_BYPASS_QUIET=false
# How often the heartbeat checks whether anything is worth a nudge.
# PROACTIVE_INTERVAL_SECONDS=3600
# A due reminder waits for a lull of this many minutes after your last message, so it
# never lands mid-exchange (see REMINDER_MAX_DEFER_HOURS for the cap on that wait).
# REMINDER_QUIET_AFTER_MSG_MINUTES=5

# --- Knowledge Q&A (ask) ---------------------------------------------------
# Semantic retrieval over your saved notes/documents (BGE-M3 embeddings). She answers
# from the KB only and says so when it holds nothing.
# How many chunks are retrieved, and the character budget handed to the model.
# ASK_TOP_K=6
# ASK_CONTEXT_CHARS=6000
# Semantic chunks below this cosine score are ignored.
# ASK_MIN_SCORE=0.25
# Chunk size used when a document is indexed (changing it only affects NEW chunks).
# CHUNK_CHARS=800

# --- Housekeeping ----------------------------------------------------------
# Interim artifacts (voice notes, orphaned media) are auto-purged after
# processing; review .md exports are trimmed to the newest N.
# REVIEW_KEEP=10

# --- Backup ----------------------------------------------------------------
# Weekly-by-default consistent snapshot of the DB (everything Cara is lives in
# ingest.db). The interval is rolling days since the last successful snapshot:
# gzipped under /var/lib/tg-ingest-agent/backups (newest BACKUP_KEEP kept) and
# copied OFF-BOX after AES-256/PBKDF2 encryption — to the DO Space when the binary
# storage backend is set to `spaces` (see that section below), else posted to the
# fleet notify chat. Keep the passphrase recovery copy outside the VPS and repo.
# With neither target configured the snapshot stays local-only and a warning is
# logged. (The prose above deliberately does not spell that setting as an
# assignment: every KEY=value line here is a template line, and uncommenting a
# sentence would put the sentence inside the value.)
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_DAYS=7
# BACKUP_KEEP=7
# BACKUP_ENCRYPTION_KEY_FILE=/etc/tg-ingest-agent-backup.key
# Low-disk alert: percent of the DB filesystem still free below which Cara tells
# the boss once (and once more when it recovers). A full disk breaks every write
# at once, so the warning has to arrive while there is still room. 0 disables.
# DISK_ALERT_MIN_FREE_PCT=10

# --- Remote fetch ----------------------------------------------------------
# Reading a link the operator sends ("прочитай https://..."); SSRF-guarded
# (public http/https + public t.me only).
# FETCH_ENABLED=true
# FETCH_TIMEOUT_SECONDS=20
# FETCH_MAX_BYTES=2097152
# A link-centric saved note (short text + URL) is summarized from the ACTUAL
# fetched page (same SSRF guard), and the page text is indexed for "ask".
# INGEST_READ_LINKS=true
# INGEST_FETCH_CHARS=3500

# --- Binary storage --------------------------------------------------------
# Default 'local' (files under MEDIA_DIR). Set 'spaces' + the keys below to
# also upload photos to a DigitalOcean Space for durability. Built now,
# dormant until configured (with backend=local nothing changes).
# STORAGE_BACKEND=local
# SPACES_REGION=fra1
# SPACES_BUCKET=cara-media
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# SPACES_KEY=REPLACE_ME
# SPACES_SECRET=REPLACE_ME
# SPACES_PREFIX=media

# --- Taxonomy ------------------------------------------------------------
# Optional seed (comma/pipe-separated); categories also emerge from confirmed
# suggestions.
# CATEGORIES=news,tools,ideas
# CATEGORIES_FILE=/etc/tg-ingest-agent/categories.txt
# FALLBACK_CATEGORY=uncategorized

# --- Register (work/off-hours resting tone) --------------------------------
# Her resting tone is set by whether it's work time AND whether he's been doing
# business recently — never a rigid day/night gate, and always overridden by how
# personal his actual message is. After heavy business she stays in working style
# for WORK_REGISTER_HOLD_MINUTES, then eases back to the time-of-day baseline.
# WORK_REGISTER_HOLD_MINUTES=40
# WORK_HOURS_START=9
# WORK_HOURS_END=19
# Weekday numbers, 0=Mon .. 6=Sun (default Mon-Fri).
# WORK_DAYS=0,1,2,3,4
# A due reminder fires at its time — even inside QUIET_HOURS — waiting only for a
# ~5-min lull after your last message.
# The lull can't defer a reminder forever: overdue past this cap it fires even
# mid-exchange (0 disables the valve).
# REMINDER_MAX_DEFER_HOURS=2
# A fired one-shot reminder left unacked auto-closes after this many days (0 disables),
# so the "ждёт готово" list doesn't pile up.
# REMINDER_FIRED_EXPIRE_DAYS=3
# Telemetry retention: traces, done/failed events+jobs, the proactive audit log and
# expired model cooldowns are pruned past this window by housekeeping (0 disables).
# Spend history (llm_usage), conversation, issues and memory tables are never pruned.
# TELEMETRY_RETENTION_DAYS=90

# --- Models / plumbing -----------------------------------------------------
# Cara's MAIN chat model id on DO Gradient serverless inference: routing, ingest,
# conversation, grounded answers. Must be a model currently enabled for this
# DigitalOcean account, and priced in llm.DEFAULT_PRICING or PRICING_JSON.
# It does NOT have to be vision-capable — that is VISION_MODEL's job below.
# DO_CHAT_MODEL=deepseek-4-flash
# Vision-capable model id, used ONLY to describe photos when DO_CHAT_MODEL cannot see.
# Empty (the code default) means photos are handled text-only from the caption, so a
# fresh box rebuilt from this file loses photo description until this is set.
# VISION_MODEL=llama-4-maverick
# Embedding model behind "ask" and every semantic match.
# DO_EMBEDDING_MODEL=BGE-M3
# Named model profiles (primary + fallbacks + max_tokens + json_required +
# temperature) overriding llm.default_profiles, as ONE line of JSON. Only the keys
# you name are overridden; a profile with no "primary" is backfilled with
# DO_CHAT_MODEL and logs a warning. Invalid JSON is ignored with a log line, and any
# slug here that is not priced makes every call bill at the punitive default.
# Profile names: router_fast, ingest_balanced, ask_grounded, converse_warm,
# memory_curator, memory_consolidate, task_planner, task_synthesis,
# improvement_evaluator.
# LLM_PROFILES_JSON={"converse_warm": {"primary": "deepseek-v4-pro", "fallbacks": ["openai-gpt-oss-20b"]}}
# How long a model that failed is benched before it is tried as primary again.
# LLM_FALLBACK_COOLDOWN_SECONDS=300
# How often the model-health monitor probes that Cara's models are reachable, so she
# can tell you the moment one goes down (and when it recovers). 0 disables.
# MODEL_HEALTH_INTERVAL_SECONDS=1800
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# DB_PATH=/var/lib/tg-ingest-agent/ingest.db
# MEDIA_DIR=/var/lib/tg-ingest-agent/media
# POLL_TIMEOUT_SECONDS=50
# ALBUM_SETTLE_SECONDS=3
# MAX_LLM_IMAGES=4
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_ATTEMPTS=5
# RETRY_INTERVAL_SECONDS=300
# Consecutive health-check failures before an alert. Transient provider overloads
# use the longer threshold so ordinary 429 failover does not create down/back noise.
# MODEL_HEALTH_CONFIRM_CHECKS=2
# MODEL_HEALTH_TRANSIENT_CONFIRM_CHECKS=4

# --- Governed chief-of-staff tasks ----------------------------------------
# Derived drafts stay below this managed root. The installer owns it as
# tg-ingest and the purge-all flow removes its contents.
# TASK_ARTIFACTS_DIR=/var/lib/tg-ingest-agent/task-artifacts
# One-way spool shared with the networkless cara-worker service. Keep this path
# aligned with cara-worker.service; the installer creates the ownership split.
# TASK_WORKER_SPOOL=/var/lib/cara-worker/spool
# TASK_WORKER_ENABLED=true
# Per-task ceilings include planning/synthesis calls and are below global budget.
# TASK_MODEL_CALL_LIMIT=4
# TASK_COST_LIMIT_USD=0.15
# TASK_OPEN_LIMIT=20
# Provider-neutral Web search. Brave is the first reviewed adapter; keep its
# subscription token only in /etc/tg-ingest-agent.env, never in this repo.
# With no key, WEB_SEARCH_PROVIDER defaults to disabled.
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=REPLACE_ME
# WEB_SEARCH_TIMEOUT_SECONDS=12
# WEB_SEARCH_MAX_BYTES=524288
# WEB_SEARCH_RESULT_LIMIT=5
# Retries consume this task-level call cap too.
# WEB_SEARCH_TASK_QUERY_LIMIT=2
# Brave Search is currently $5/1,000 calls; this reserve joins TASK_COST_LIMIT_USD.
# WEB_SEARCH_COST_PER_QUERY_USD=0.005
# Evidence-only improvement analysis schedule, boss-local time (0=Mon..6=Sun).
# IMPROVEMENT_WEEKDAY=6
# IMPROVEMENT_HOUR=4
# The separate Mentor receives only redacted evidence and an inference-only
# credential. Its networkless runner tests bounded candidates in quarantine.
# Passing candidates become approval-ready but never merge, push, or deploy.
# MENTOR_ENABLED=true
# MENTOR_REVIEW_SPOOL=/var/lib/cara-mentor/spool
# MENTOR_RUNNER_SPOOL=/var/lib/cara-mentor-runner/spool
# MENTOR_RESULT_TIMEOUT_HOURS=48
# The next three values are copied into root-owned /etc/cara-mentor.env only.
# MENTOR_MODEL=deepseek-4-flash
# MENTOR_LLM_TIMEOUT_SECONDS=90
# One call persists the proposal; up to three candidate attempts use 1h/6h backoff.
# MENTOR_MAX_CALLS_PER_WEEK=4
# MENTOR_TEST_TIMEOUT_SECONDS=600

# --- Fleet deploy notices --------------------------------------------------
# Build/deploy notices post to the shared FLEET notification bot (the ops channel the
# other VPSes use), NOT into the boss's chat with Cara. Copy the values from the box's
# root-only /etc/codex-auto-update/telegram.env (the tg-ingest user can't read that file,
# and its var names collide with Cara's own token, so they're re-declared here under
# distinct names). Leave blank to skip deploy notices entirely.
# The real token and chat id are NEVER committed (operator policy: no chat ids or
# tokens in tracked files). Both live only in /etc/codex-auto-update/telegram.env on
# the box — read them there and paste them into /etc/tg-ingest-agent.env by hand.
# In order: the fleet bot token (NOT Cara's), the fleet ops chat id, and the label
# shown in the notice line. Uncomment as-is — a trailing `# note` would become part
# of the VALUE (see the header: systemd does not strip inline comments).
# FLEET_NOTIFY_BOT_TOKEN=REPLACE_ME
# FLEET_NOTIFY_CHAT_ID=REPLACE_ME
# FLEET_NOTIFY_LABEL=tg-ingest-agent (Cara)
