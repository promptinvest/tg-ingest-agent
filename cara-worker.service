[Unit]
Description=Cara isolated local task worker
After=local-fs.target

[Service]
Type=simple
User=cara-worker
Group=cara-worker-spool
UMask=0027
Environment=CARA_WORKER_SPOOL=/var/lib/cara-worker/spool
Environment=CARA_WORKER_STATE=/var/lib/cara-worker
ExecStart=/usr/bin/python3 /opt/tg-ingest-agent/cara_worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/opt/tg-ingest-agent/cara_worker.py
InaccessiblePaths=/etc/tg-ingest-agent.env /var/lib/tg-ingest-agent /etc/tg-ingest-agent-backup.key /etc/nikki-agent.env /var/lib/nikki-agent /etc/nikki-agent-backup.key /etc/codex-auto-update/telegram.env
ReadWritePaths=/var/lib/cara-worker
RuntimeDirectory=cara-worker
RuntimeDirectoryMode=0750
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
