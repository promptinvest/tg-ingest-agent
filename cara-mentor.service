[Unit]
Description=Cara independent evidence-bound Mentor reviewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cara-mentor
Group=cara-mentor-spool
UMask=0027
EnvironmentFile=/etc/cara-mentor.env
Environment=MENTOR_REVIEW_SPOOL=/var/lib/cara-mentor/spool
Environment=MENTOR_STATE=/var/lib/cara-mentor
Environment=MENTOR_SOURCE_DIR=/opt/cara-mentor-source
ExecStart=/usr/bin/python3 /opt/tg-ingest-agent/cara_mentor.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/opt/tg-ingest-agent/cara_mentor.py /opt/tg-ingest-agent/mentor_protocol.py /opt/cara-mentor-source /etc/cara-mentor.env
InaccessiblePaths=/etc/tg-ingest-agent.env /var/lib/tg-ingest-agent /var/lib/cara-worker /var/lib/cara-mentor-runner /etc/tg-ingest-agent-backup.key /etc/nikki-agent.env /var/lib/nikki-agent /etc/nikki-agent-backup.key /etc/codex-auto-update/telegram.env /root/.ssh
ReadWritePaths=/var/lib/cara-mentor
RuntimeDirectory=cara-mentor
RuntimeDirectoryMode=0750
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
